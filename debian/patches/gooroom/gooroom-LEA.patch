@@ -0,0 +1,136 @@
+#define XAR_SSE2(v0, v1, cur, pre, tmp, rk1, rk2) \
+    movd   rk2, tmp; \
+    pshufd $0, tmp, tmp; \
+    pxor   tmp, cur; \
+    movd   rk1, tmp; \
+    pshufd $0, tmp, tmp; \
+    pxor   pre, tmp; \
+    paddd  cur, tmp; \
+    movdqa tmp, cur; \
+    psrld  v0, tmp; \
+    pslld  v1, cur; \
+    pxor   tmp, cur;
+
+
+#define XSR_SSE2(v0, v1, cur, pre, tmp, rk1, rk2) \
+    movdqa cur, tmp; \
+    psrld  v0, cur; \
+    pslld  v1, tmp; \
+    pxor   tmp, cur; \
+    movd   rk1, tmp; \
+    pshufd $0, tmp, tmp; \
+    pxor   pre, tmp; \
+    psubd  tmp, cur; \
+    movd   rk2, tmp; \
+    pshufd $0, tmp, tmp; \
+    pxor   tmp, cur;
+
+
+
+#define XAR3_SSE2(cur, pre, tmp, rk1, rk2) \
+    XAR_SSE2($3, $29, cur, pre, tmp, rk1, rk2)
+
+#define XAR5_SSE2(cur, pre, tmp, rk1, rk2) \
+    XAR_SSE2($5, $27, cur, pre, tmp, rk1, rk2)
+
+#define XAR9_SSE2(cur, pre, tmp, rk1, rk2) \
+    XAR_SSE2($23, $9, cur, pre, tmp, rk1, rk2)
+
+
+#define XSR9_SSE2(cur, pre, tmp, rk1, rk2) \
+    XSR_SSE2($9, $23, cur, pre, tmp, rk1, rk2)
+    
+#define XSR5_SSE2(cur, pre, tmp, rk1, rk2) \
+    XSR_SSE2($27, $5, cur, pre, tmp, rk1, rk2)
+
+#define XSR3_SSE2(cur, pre, tmp, rk1, rk2) \
+    XSR_SSE2($29, $3, cur, pre, tmp, rk1, rk2)
+
+#define LOAD_BLOCK4(x0, x1, x2, x3, mem) \
+	movdqu 0 * 16(mem), x0; \
+    movdqu 1 * 16(mem), x1; \
+    movdqu 2 * 16(mem), x2; \
+    movdqu 3 * 16(mem), x3;
+
+#define JOIN_BLOCK4(x0, x1, out_x2, x3, tmp, in_x2) \
+    movdqa x0, out_x2; \
+    movdqa in_x2, tmp; \
+    punpckhdq x1, out_x2; \
+    punpckldq x1, x0; \
+    punpckhdq x3, in_x2; \
+    punpckldq x3, tmp; \
+    \
+    movdqa x0, x1; \
+    movdqa out_x2, x3; \
+    punpcklqdq tmp, x0; \
+    punpckhqdq tmp, x1; \
+    punpcklqdq in_x2, out_x2; \
+    punpckhqdq in_x2, x3;
+
+#define SPLIT_BLOCK4(x0, x1, out_x2, x3, tmp, in_x2) \
+    movdqa x0, out_x2; \
+    movdqa in_x2, tmp; \
+    punpckldq x1, x0; \
+    punpckhdq x1, out_x2; \
+    punpckldq x3, tmp; \
+    punpckhdq x3, in_x2; \
+    \
+    movdqa x0, x1; \
+    movdqa out_x2, x3; \
+    punpcklqdq tmp, x0; \
+    punpckhqdq tmp, x1; \
+    punpcklqdq in_x2, out_x2; \
+    punpckhqdq in_x2, x3;
+
+#define XOR_BLOCK3(x0, x1, x2, tmp0, tmp1, tmp2, mem) \
+    movdqu 0 * 16(mem), tmp0; \
+    movdqu 1 * 16(mem), tmp1; \
+    movdqu 2 * 16(mem), tmp2; \
+    pxor tmp0, x0;            \
+    pxor tmp1, x1;            \
+    pxor tmp2, x2;
+
+#define STORE_BLOCK4(x0, x1, x2, x3, mem) \
+    movdqu x0, 0 * 16(mem); \
+    movdqu x1, 1 * 16(mem); \
+    movdqu x2, 2 * 16(mem); \
+    movdqu x3, 3 * 16(mem);
+
+#define LEA_1ROUND_ENC(x0, x1, x2, x3, tmp, rk, rnd_num) \
+    XAR3_SSE2(x3, x2, tmp, (((rnd_num) * 6 + 4) * 4)(rk), (((rnd_num) * 6 + 5) * 4)(rk)); \
+    XAR5_SSE2(x2, x1, tmp, (((rnd_num) * 6 + 2) * 4)(rk), (((rnd_num) * 6 + 3) * 4)(rk)); \
+    XAR9_SSE2(x1, x0, tmp, (((rnd_num) * 6 + 0) * 4)(rk), (((rnd_num) * 6 + 1) * 4)(rk));
+
+#define LEA_4ROUND_ENC(x0, x1, x2, x3, tmp, rk, rnd_num) \
+    LEA_1ROUND_ENC(x0, x1, x2, x3, tmp, rk, rnd_num + 0); \
+    LEA_1ROUND_ENC(x1, x2, x3, x0, tmp, rk, rnd_num + 1); \
+    LEA_1ROUND_ENC(x2, x3, x0, x1, tmp, rk, rnd_num + 2); \
+    LEA_1ROUND_ENC(x3, x0, x1, x2, tmp, rk, rnd_num + 3);
+
+#define LEA_1ROUND_DEC(x0, x1, x2, x3, tmp, rk, rnd_num) \
+    XSR9_SSE2(x0, x3, tmp, (((rnd_num) * 6 + 0) * 4)(rk), (((rnd_num) * 6 + 1) * 4)(rk)); \
+    XSR5_SSE2(x1, x0, tmp, (((rnd_num) * 6 + 2) * 4)(rk), (((rnd_num) * 6 + 3) * 4)(rk)); \
+    XSR3_SSE2(x2, x1, tmp, (((rnd_num) * 6 + 4) * 4)(rk), (((rnd_num) * 6 + 5) * 4)(rk));
+
+#define LEA_4ROUND_DEC(x0, x1, x2, x3, tmp, rk, rnd_num) \
+    LEA_1ROUND_DEC(x0, x1, x2, x3, tmp, rk, rnd_num + 3); \
+    LEA_1ROUND_DEC(x3, x0, x1, x2, tmp, rk, rnd_num + 2); \
+    LEA_1ROUND_DEC(x2, x3, x0, x1, tmp, rk, rnd_num + 1); \
+    LEA_1ROUND_DEC(x1, x2, x3, x0, tmp, rk, rnd_num + 0);
+
+
+.section	.rodata.lea_sse2.xts_tweak_mask
+.align 16
+.Lxts_tweak_mask:
+	.octa 0x00000000000000010000000000000087
+
+#define XTS_LOAD_TWEAK_MASK(mask) \
+    movdqa .Lxts_tweak_mask, mask;
+
+#define XTS_NEXT_TWEAK_1BLOCK(out0, in0, tmp0, mask) \
+    pshufd $0x13, in0, tmp0; \
+    movdqa in0, out0; \
+    psrad $31, tmp0; \
+    pand mask, tmp0; \
+    psllq $1, out0; \
+    pxor tmp0, out0;
diff --git a/crypto/lea/crypto_lea_sse2_i586-asm.S b/crypto/lea/crypto_lea_sse2_i586-asm.S
