+SYM_FUNC_START(lea_ctr_enc_8way)
+	/* input:
+	 *	arg_ctx(%esp): ctx, CTX
+	 *	arg_dst(%esp): dst
+	 *	arg_src(%esp): src
+     *  arg_iv (%esp): iv
+     *  arg_buf(%esp): buffer
