+    SPLIT_AND_STORE8_YMM(i0, 0, mem);\
+    SPLIT_AND_STORE8_YMM(i1, 4, mem);\
+    SPLIT_AND_STORE8_YMM(i2, 8, mem);\
+    SPLIT_AND_STORE8_YMM(i3, 12, mem);
