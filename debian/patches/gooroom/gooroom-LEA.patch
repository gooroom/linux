+++ b/crypto/lea/crypto_lea_sse2_i586-asm.S
@@ -0,0 +1,282 @@
+#include <linux/linkage.h>
+#include <asm/frame.h>
+#include "crypto_lea_sse2-asm.S"
+#include "crypto_lea_util_x86-asm.S"
+
+.file "crypto_lea_sse2_i586-asm.S"
+
+#define LEA_MAX_KEYLENGTH (32 * 6 * 4)
+
+.text
+
+.align 8
+SYM_FUNC_START_LOCAL(__lea_enc_4way)
+	/* input:
+	 *	%edi: ctx, CTX
+	 *	%xmm0..%xmm3: 4 plaintext blocks
+	 * output:
+	 *	%xmm0..%xmm3: 4 encrypted blocks
+	 */
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 0);
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 4);
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 8);
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 12);
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 16);
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 20);
+
+    cmpl $24, LEA_MAX_KEYLENGTH(%edi);
+    je .Lenc_done;
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 24);
+
+    cmpl $28, LEA_MAX_KEYLENGTH(%edi);
+    je .Lenc_done;
+    LEA_4ROUND_ENC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 28);
+
+.Lenc_done:
+	RET;
+SYM_FUNC_END(__lea_enc_4way)
+
+.align 8
+SYM_FUNC_START_LOCAL(__lea_dec_4way)
+	/* input:
+	 *	%edi: ctx, CTX
+	 *	%xmm0..%xmm3: 4 encrypted blocks
+	 * output:
+	 *	%xmm0..%xmm3: 4 plaintext blocks
+	 */
+    cmpl $28, LEA_MAX_KEYLENGTH(%edi);
+    jbe .Lenc_24;
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 28);
+
+.Lenc_24:
+    cmpl $24, LEA_MAX_KEYLENGTH(%edi);
+    jbe .Lenc_20;
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 24);
+
+.Lenc_20:
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 20);
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 16);
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 12);
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 8);
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 4);
+    LEA_4ROUND_DEC(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %edi, 0);
+ 
+	RET;
+SYM_FUNC_END(__lea_dec_4way)
+
+.align 8
+SYM_FUNC_START(lea_ecb_enc_4way)
+	/* input:
+	 *	arg_ctx(%esp): ctx, CTX
+	 *	arg_dst(%esp): dst
+	 *	arg_src(%esp): src
+	 */
+	FRAME_BEGIN
+
+    push %edi;
+
+    movl (arg_ctx + 4*1)(%esp), %edi;
+    movl (arg_src + 4*1)(%esp), %eax;
+
+    LOAD_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %eax);
+    JOIN_BLOCK4(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %xmm5);
+
+    call __lea_enc_4way
+
+    movl (arg_dst + 4*1)(%esp), %eax;
+
+    SPLIT_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %xmm4, %xmm2);
+    STORE_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %eax);
+
+    pop %edi;
+
+    FRAME_END
+	RET;
+SYM_FUNC_END(lea_ecb_enc_4way)
+
+.align 8
+SYM_FUNC_START(lea_ecb_dec_4way)
+    /* input:
+	 *	arg_ctx(%esp): ctx, CTX
+	 *	arg_dst(%esp): dst
+	 *	arg_src(%esp): src
+	 */
+	FRAME_BEGIN
+
+    push %edi;
+
+    movl (arg_ctx + 4*1)(%esp), %edi;
+    movl (arg_src + 4*1)(%esp), %eax;
+
+    LOAD_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %eax);
+    JOIN_BLOCK4(%xmm0, %xmm1, %xmm2, %xmm3, %xmm4, %xmm5);
+
+    call __lea_dec_4way
+
+    movl (arg_dst + 4*1)(%esp), %eax;
+
+    SPLIT_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %xmm4, %xmm2);
+    STORE_BLOCK4(%xmm0, %xmm1, %xmm5, %xmm3, %eax);
+
+    pop %edi;
+
+    FRAME_END
+	RET;
+SYM_FUNC_END(lea_ecb_dec_4way)
+
+
+.align 8
+SYM_FUNC_START(lea_cbc_dec_4way)
+    /* input:
+	 *	arg_ctx(%esp): ctx, CTX
+	 *	arg_dst(%esp): dst
+	 *	arg_src(%esp): src
+	 */
+	FRAME_BEGIN
+
