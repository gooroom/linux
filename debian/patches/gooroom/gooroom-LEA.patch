+    xts_next_tweak(walk.iv, walk.iv);
+
+    xor_1blk(buffer, walk.iv, buffer);
+    __crypto_lea_encrypt(ctx->raw_crypt_ctx, buffer, buffer);
+    xor_1blk(dst, walk.iv, buffer);
+
+    kernel_fpu_end();
+    ret = skcipher_walk_done(&walk, 0);
+  }
