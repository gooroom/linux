+    vmovd XMM(i), (j + 0 * 16)(mem);\
+    vpextrd $0x1, XMM(i), (j + 1 * 16)(mem);\
+    vpextrd $0x2, XMM(i), (j + 2 * 16)(mem);\
+    vpextrd $0x3, XMM(i), (j + 3 * 16)(mem);
