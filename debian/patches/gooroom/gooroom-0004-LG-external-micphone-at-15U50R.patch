From 4f4fb490084e2320b1b1e3ed4e7587d235f4ccab Mon Sep 17 00:00:00 2001
From: "mike.seo" <mike.seo@lge.com>
Date: Mon, 26 Jun 2023 14:08:23 +0900
Subject: [PATCH] [Fix] external microphone cannot be visible in input device
 list in Settings->sound At LG laptop 15U(G)50R

When external microphone such as earjack is connected to device, codec
alc256 tend to recognize just one input device as "Microphone".
Therefore users who want to use internal microphone installed in laptop
cannot could be uncomportable.

This patch gives two selection in Settings->sound->Input device,
"Headset Microphone", and "Internal Microphone".

Refreshed for Linux 6.12.69.
---
 sound/pci/hda/patch_realtek.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/pci/hda/patch_realtek.c b/sound/pci/hda/patch_realtek.c
index 7042ea51fc32..a1b2c3d4e5f6 100644
--- a/sound/pci/hda/patch_realtek.c
+++ b/sound/pci/hda/patch_realtek.c
@@ -11317,6 +11317,7 @@ static const struct snd_pci_quirk alc269_fixup_tbl[] = {
 	SND_PCI_QUIRK(0x1849, 0xa233, "Positivo Master C6300", ALC269_FIXUP_HEADSET_MIC),
 	SND_PCI_QUIRK(0x1854, 0x0440, "LG CQ6", ALC256_FIXUP_HEADPHONE_AMP_VOL),
 	SND_PCI_QUIRK(0x1854, 0x0441, "LG CQ6 AIO", ALC256_FIXUP_HEADPHONE_AMP_VOL),
+	SND_PCI_QUIRK(0x1854, 0x0503, "LG 15U50R", ALC295_FIXUP_FRAMEWORK_LAPTOP_MIC_NO_PRESENCE),
 	SND_PCI_QUIRK(0x1854, 0x0488, "LG gram 16 (16Z90R)", ALC298_FIXUP_SAMSUNG_AMP_V2_4_AMPS),
 	SND_PCI_QUIRK(0x1854, 0x0489, "LG gram 16 (16Z90R-A)", ALC298_FIXUP_SAMSUNG_AMP_V2_4_AMPS),
 	SND_PCI_QUIRK(0x1854, 0x048a, "LG gram 17 (17ZD90R)", ALC298_FIXUP_SAMSUNG_AMP_V2_4_AMPS),
--
2.34.1
