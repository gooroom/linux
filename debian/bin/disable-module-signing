#!/bin/bash
#
# Disable module signing for build environments where signing keys are not available
# This creates unsigned kernel packages suitable for development/testing
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEBIAN_DIR="$(dirname "${SCRIPT_DIR}")"

echo "[Signing] Disabling module signing in kernel config..."

# Find all config files and disable module signing
find "${DEBIAN_DIR}/config" -name "config*" -type f | while read config_file; do
    if [ -f "$config_file" ]; then
        # Comment out or disable module signing options
        sed -i 's/^CONFIG_MODULE_SIG=y/# CONFIG_MODULE_SIG is not set/' "$config_file" 2>/dev/null || true
        sed -i 's/^CONFIG_MODULE_SIG_ALL=y/# CONFIG_MODULE_SIG_ALL is not set/' "$config_file" 2>/dev/null || true
        sed -i 's/^CONFIG_MODULE_SIG_FORCE=y/# CONFIG_MODULE_SIG_FORCE is not set/' "$config_file" 2>/dev/null || true
        sed -i 's/^CONFIG_MODULE_SIG_KEY=.*$/# CONFIG_MODULE_SIG_KEY is not set/' "$config_file" 2>/dev/null || true
        echo "[Signing] Processed: $config_file"
    fi
done

echo "[Signing] Module signing disabled. Building unsigned packages."
echo "[Signing] WARNING: These packages are for development/testing only!"
echo "[Signing] For production, use properly signed packages."